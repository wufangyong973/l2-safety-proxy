{
  "name": "l2-send-guard",
  "version": "0.5.0",
  "description": "Multi-L2 pre-broadcast JSON-RPC safety middleware \u2014 simulate eth_sendRawTransaction, abort definite reverts, fail-open on uncertainty; optional Layer 2 address/spend policy; AgentKit/viem drop-in helpers",
  "type": "module",
  "main": "./dist/api.js",
  "bin": {
    "l2-send-guard": "./dist/index.js"
  },
  "files": [
    "dist",
    "policy.agent.example.json",
    "policy.example.json",
    ".env.example",
    "docs/TROUBLESHOOTING.md",
    "docs/AGENT_DECISION_TABLE.md",
    "docs/RESIDUAL_BYPASSES.md",
    "docs/DECISION_LOG.md",
    "docs/BUYER_ACCEPTANCE.md",
    "docs/fixtures/dual-layer.expected.txt",
    "src/sdk/README.md",
    "SUPPORT.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yellowgram/l2-safety-proxy.git"
  },
  "bugs": {
    "url": "https://github.com/yellowgram/l2-safety-proxy/issues"
  },
  "homepage": "https://github.com/yellowgram/l2-safety-proxy#readme",
  "scripts": {
    "build": "node api.js && tsc",
    "start": "node api.js && node dist/index.js",
    "dev": "node api.js && tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "bench": "tsx scripts/bench.ts",
    "demo:offline": "node scripts/demo-offline.mjs",
    "demo:live": "node scripts/live-smoke-cache.mjs",
    "demo:sepolia": "node scripts/demo-sepolia.mjs",
    "eval": "tsx evaluation/run.ts",
    "eval:generate": "tsx evaluation/generate-fixtures.ts",
    "agent:loop": "tsx src/agent/loop.ts",
    "demo:delta-a": "node --env-file=.env scripts/delta-a-live-proof.mjs",
    "probe:gascap": "bash scripts/check-rpc-gascap.sh",
    "demo:dual-layer": "node scripts/demo-dual-layer.mjs",
    "policy:check": "tsx scripts/policy-check.ts",
    "demo:agent-halt": "node examples/agent-viem-halt.mjs",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ethereum",
    "l2",
    "arbitrum",
    "optimism",
    "base",
    "json-rpc",
    "simulation",
    "middleware"
  ],
  "license": "MIT",
  "dependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    },
    "./sdk": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk/index.js"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "import": "./dist/agent/index.js"
    }
  },
  "types": "./dist/api.d.ts"
}
